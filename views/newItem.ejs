<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1><%= title %></h1>
    <br>
    <form method="post">
        <label for="name">Item's name:</label><br>
        <input type="text" id="name" name="name">
        <br><br>        
        <label for="category">Item's cat.:</label><br>
        <select type="text" id="category" name="category">
            <option selected value="">Select an option</option>
            <option value="elektronika">Elektronika</option>
            <option value="ruházat">Ruházat</option>
            <option value="könyv">Könyv</option>
            <option value="játék">Játék</option>
        </select>
        <br><br>
        <label for="price">Item's price:</label><br>
        <input type="number" id="price" name="price">
        <br><br>   
        <label for="stock">Item's stock:</label><br>
        <input type="text" id="stock" name="stock">
        <br><br>   
        <button type="submit">Filter</button>
    </form>
    <br>
    <br>
    <table>
        <thead>
            <tr>
                <td>
                    Name
                </td>
                <td>
                    Category
                </td>
                <td>
                    Price
                </td>
                <td>
                    Stock
                </td>
            </tr>
        </thead>
        <tbody>
            <% data.forEach(element => { %> 
                <tr style = "<%-element.stock <= 0 ? "font-weight: bold; background-color: red; color: whitesmoke;" : element.stock < 5 ? "font-weight: bold; color:  red;" : ""%>">
                    <td><%= element.name %></td>
                    <td><%= element.category %></td>
                    <td><%= element.price %></td>
                    <td><%= element.stock %></td>
                </tr>
            <% }); %>
        </tbody>
    </table>
    <br>
    <p style="color: green;"><%= message  %></p>
    <br>
    <a href="/" target="_self"><button>Home Page</button></a><br>
    <a href="/filter" target="_self"><button>Filter Page</button></a>
</body>
</html>