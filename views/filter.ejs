<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1><%= title %></h1>
    <br>
    <form action="/filter">
        <label for="catFilter">Category Selection:</label><br>
        <select type="text" id="catFilter" name="catFilter">
            <option selected value="">Select an option</option>
            <option value="elektronika">Elektronika</option>
            <option value="ruházat">Ruházat</option>
            <option value="könyv">Könyv</option>
            <option value="játék">Játék</option>
        </select>
        <br>
        <button type="submit">Filter</button>
    </form>
    <br>
    <br>
    <table>
        <thead>
            <tr>
                <td>
                    Name
                </td>
                <td>
                    Category
                </td>
                <td>
                    Price
                </td>
                <td>
                    Stock
                </td>
            </tr>
        </thead>
        <tbody>
            <% data.forEach(element => { %> 
                <tr style = "<%-element.stock <= 0 ? "font-weight: bold; background-color: red; color: whitesmoke;" : element.stock < 5 ? "font-weight: bold; color:  red;" : ""%>">
                    <td><%= element.name %></td>
                    <td><%= element.category %></td>
                    <td><%= element.price %></td>
                    <td><%= element.stock %></td>
                </tr>
            <% }); %>
        </tbody>
    </table>
    <br>
    <br>
    <a href="/" target="_self"><button>Home Page</button></a><br>
    <a href="/newItem" target="_self"><button>Add new Item</button></a>
</body>
</html>